# Copie para .env e preencha com os valores reais.
# O .env local vem de: npx vercel env pull .env   (ambiente Development)
# Nunca versione o .env (o gate node scripts/verifica-higiene.mjs bloqueia).

# Conexao Development/Preview do Neon (obrigatoria em qualquer ambiente).
DATABASE_URL=

# Conexao direta (sem pooler) usada apenas pelo aplicador de schema.
DATABASE_URL_UNPOOLED=

# Conexao do branch main do Neon; usada somente quando VERCEL_ENV=production.
DATABASE_URL_PRODUCAO=

# Segredo HMAC da sessao (cookie escala_sessao). Minimo de 32 caracteres.
# Gere com: .\gerador-de-senha.ps1 -Tamanho 48
SESSION_SECRET=

# Cadeia CA do proxy da rede corporativa; apenas em ambiente local/CLI.
# NODE_EXTRA_CA_CERTS=C:\caminho\para\ca.pem

# Definido pela Vercel (production | preview | development); controla
# ambiente, conexao de banco e o badge NEXT_PUBLIC_AMBIENTE.
# VERCEL_ENV=
